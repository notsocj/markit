# Never commit secrets. marKit keeps real keys in ~/.config/markit/.env, outside this repo,
# but this guards against someone copying one in by accident.
.env
.env.*

# Local test output and OS clutter
markit-reports/
*.tmp
.DS_Store
node_modules/

# Leftovers from running `npx skills add/remove` with PROJECT scope inside this repo.
# Never do that here: the installer treats this repo's skills/ folder (marKit's source)
# as an install location, and a project-scope remove deletes it. Use -g (global).
.agents/
.claude/skills/
skills-lock.json
